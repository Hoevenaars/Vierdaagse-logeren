---
import ContentPage from '../layouts/ContentPage.astro';
import AanmeldFormulier from '../components/AanmeldFormulier.astro';
import campings from '../data/campings.json';
---

<ContentPage
  title="Kamperen tijdens de Vierdaagse — Vierdaagse Logeren"
  description="Kamperen tijdens de Vierdaagse Nijmegen — praktische info over prijs, voorzieningen en wanneer je moet boeken."
  locale="nl"
  h1="Kamperen tijdens de Vierdaagse"
>
  <p>
    Rond Nijmegen liggen verschillende campings die tijdens de Vierdaagse-week extra druk
    zijn. Reken op volle capaciteit ruim voor het evenement zelf — kamperen is een van de
    eerste opties die uitverkocht raakt.
  </p>

  <h2>Wat kost een kampeerplek</h2>
  <p>
    Reken tijdens de Vierdaagse op hogere tarieven dan een normale zomerweek. Zodra we
    concrete aanbieders hebben aangesloten, vind je hier een actuele prijsindicatie.
  </p>

  <h2>Wat te verwachten</h2>
  <p>
    Sanitair en voorzieningen zijn vaak beperkter dan je gewend bent op een reguliere
    camping, gezien de tijdelijke drukte. Vroeg boeken geeft meer keuze in ligging en
    voorzieningen.
  </p>

  {campings.length > 0 ? (
    <>
      <h2>Campings in dit gebied</h2>
      <div class="location-list">
        {campings.map((c: any) => (
          <div class="location-card">
            <h3>{c.naam} — {c.plaats}</h3>
            <p class="location-type">{c.type}</p>
            <p>{c.beschrijving}</p>
            <p class="location-contact">Contact: {c.contact}</p>
          </div>
        ))}
      </div>
    </>
  ) : (
    <>
      <h2>Campings in dit gebied</h2>
      <p class="callout">
        We werken aan een overzicht van concrete campings met boekingslinks. Bekijk
        ondertussen <a href="/gebied">de gebieden rond Nijmegen</a> voor algemene informatie.
      </p>
    </>
  )}

  <AanmeldFormulier
    categorie="camping"
    typeOpties={['Camping', 'Kampeerboerderij', 'Anders']}
    titel="Camping-eigenaar? Meld je aan"
    introtekst="Heb je een camping in de omgeving van Nijmegen en wil je zichtbaar zijn tijdens de Vierdaagse? Meld je hieronder aan. We nemen contact op om de plaatsing en eventuele boekingslink te bespreken."
  />

  <h2>Nog geen plek gevonden?</h2>
  <p>
    Bekijk ook <a href="/particuliere-verhuur">particuliere verhuur</a> of
    <a href="/hotels-bb">hotels & B&B</a>.
  </p>
</ContentPage>

<style>
  .location-list {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .location-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-base);
    padding: var(--space-4);
  }
  .location-card h3 {
    color: var(--color-primary);
    margin: 0 0 var(--space-1);
  }
  .location-type {
    font-weight: 600;
    color: var(--color-accent-1);
    margin: 0 0 var(--space-2);
  }
  .location-contact {
    font-size: var(--font-size-sm);
    opacity: 0.8;
  }
</style>
