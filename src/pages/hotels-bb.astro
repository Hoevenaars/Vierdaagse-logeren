---
import ContentPage from '../layouts/ContentPage.astro';
import AanmeldFormulier from '../components/AanmeldFormulier.astro';
import hotels from '../data/hotels.json';
---

<ContentPage
  title="Hotels en B&B's tijdens de Vierdaagse — Vierdaagse Logeren"
  description="Hotels en B&B's in en rond Nijmegen tijdens de Vierdaagse — waar te kijken en wanneer te boeken."
  locale="nl"
  h1="Hotels en B&B's tijdens de Vierdaagse"
>
  <p>
    Meer comfort en privacy dan kamperen, met opties zowel in Nijmegen zelf als in de
    omliggende gemeenten. Centraal gelegen hotels zijn doorgaans het eerst volgeboekt.
  </p>

  <h2>Wat kun je verwachten</h2>
  <p>
    Prijzen liggen tijdens de Vierdaagse-week hoger dan normaal door de grote vraag. Hoe
    centraler, hoe eerder volgeboekt en hoe hoger de prijs.
  </p>

  <h2>Waar te kijken</h2>
  <ul>
    <li>Nijmegen centrum — dichtst bij start/finish, meeste keuze, eerst vol</li>
    <li>Omliggende gemeenten — meer beschikbaarheid, iets verder reizen</li>
  </ul>

  {hotels.length > 0 ? (
    <>
      <h2>Hotels & B&B's in dit gebied</h2>
      <div class="location-list">
        {hotels.map((h: any) => (
          <div class="location-card">
            <h3>{h.naam} — {h.plaats}</h3>
            <p class="location-type">{h.type}</p>
            <p>{h.beschrijving}</p>
            <p class="location-contact">Contact: {h.contact}</p>
          </div>
        ))}
      </div>
    </>
  ) : (
    <>
      <h2>Boeken</h2>
      <p class="callout">
        Via Booking.com vind je een actueel overzicht van beschikbare hotels en B&B's in de
        regio. Zodra ons partnerprogramma actief is, vind je hier directe links.
      </p>
    </>
  )}

  <AanmeldFormulier
    categorie="hotel"
    typeOpties={['Hotel', 'B&B', 'Anders']}
    titel="Hotel of B&B in de regio? Meld je aan"
    introtekst="Heb je een hotel of B&B in de omgeving van Nijmegen en wil je zichtbaar zijn tijdens de Vierdaagse? Meld je hieronder aan. We nemen contact op om de plaatsing en eventuele boekingslink te bespreken."
  />

  <h2>Nog geen plek gevonden?</h2>
  <p>
    Bekijk ook <a href="/camping">camping</a> of
    <a href="/particuliere-verhuur">particuliere verhuur</a>.
  </p>
</ContentPage>

<style>
  .location-list {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .location-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-base);
    padding: var(--space-4);
  }
  .location-card h3 {
    color: var(--color-primary);
    margin: 0 0 var(--space-1);
  }
  .location-type {
    font-weight: 600;
    color: var(--color-accent-1);
    margin: 0 0 var(--space-2);
  }
  .location-contact {
    font-size: var(--font-size-sm);
    opacity: 0.8;
  }
</style>
