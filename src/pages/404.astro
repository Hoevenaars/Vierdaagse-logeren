---
import '../styles/tokens.css';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pagina niet gevonden — Vierdaagse Logeren</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main class="not-found">
      <img src="/logos/logo-horizontaal.svg" alt="Vierdaagse Logeren" height="40" />
      <h1>404 — Deze pagina bestaat niet</h1>
      <p>De pagina die je zoekt is niet gevonden. Ga terug naar de homepage:</p>
      <ul>
        <li><a href="/">Nederlands</a></li>
        <li><a href="/en/">English</a></li>
        <li><a href="/de/">Deutsch</a></li>
      </ul>
    </main>
    <style>
      body {
        margin: 0;
        font-family: var(--font-family-base);
        color: var(--color-text-dark);
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
      }
      .not-found {
        text-align: center;
        max-width: 28rem;
        padding: var(--space-5);
      }
      h1 {
        color: var(--color-primary);
      }
      ul {
        list-style: none;
        padding: 0;
        display: flex;
        gap: var(--space-4);
        justify-content: center;
      }
      a {
        color: var(--color-accent-1);
        font-weight: 600;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
    </style>
  </body>
</html>
