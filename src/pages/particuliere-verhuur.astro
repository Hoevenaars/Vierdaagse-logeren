---
import ContentPage from '../layouts/ContentPage.astro';
import AanmeldFormulier from '../components/AanmeldFormulier.astro';
import locations from '../data/locations.json';
---

<ContentPage
  title="Slapen bij een particulier tijdens de Vierdaagse — Vierdaagse Logeren"
  description="Een kamer, tuin of oprit bij een particulier tijdens de Vierdaagse — goedkoper dan een hotel, persoonlijker dan een camping."
  locale="nl"
  h1="Slapen bij een particulier tijdens de Vierdaagse"
>
  <p>
    Een kamer, tuin of oprit bij iemand thuis — vaak goedkoper dan een hotel,
    persoonlijker dan een camping, en een goed alternatief als de reguliere opties vol
    zitten.
  </p>

  <h2>Wat kun je verwachten</h2>
  <p>
    Variërend van een simpele kampeerplek in een achtertuin tot een volwaardige
    logeerkamer. Voorzieningen verschillen per aanbieder — vraag vooraf na wat er wel en
    niet inbegrepen is (sanitair, ontbijt, parkeren).
  </p>

  <h2>Wat het kost</h2>
  <p>
    Doorgaans lager dan een hotel, vergelijkbaar met of goedkoper dan een camping,
    afhankelijk van voorzieningen.
  </p>

  <h2>Waar je op let</h2>
  <ul>
    <li>Afstand tot startpunt/route</li>
    <li>Wat er precies inbegrepen is</li>
    <li>Duidelijke afspraken over aankomst- en vertrektijden</li>
  </ul>

  {locations.length > 0 && (
    <>
      <h2>Beschikbare locaties</h2>
      <div class="location-list">
        {locations.map((loc: any) => (
          <div class="location-card">
            <h3>{loc.naam} — {loc.plaats}</h3>
            <p class="location-type">{loc.type}</p>
            <p>{loc.beschrijving}</p>
            <p class="location-contact">Contact: {loc.contact}</p>
          </div>
        ))}
      </div>
    </>
  )}

  <AanmeldFormulier
    categorie="particulier"
    typeOpties={['Tuin/kampeerplek', 'Kamer', 'Oprit', 'Anders']}
    titel="Zelf een plek aanbieden?"
    introtekst="Heb je een tuin, kamer of oprit die je tijdens de Vierdaagse wilt aanbieden? Meld je hieronder aan. Elke aanmelding wordt handmatig gecontroleerd voordat deze zichtbaar wordt — dit duurt meestal een paar dagen."
  />

  <h2>Nog geen plek gevonden?</h2>
  <p>
    Bekijk ook <a href="/camping">camping</a> of <a href="/hotels-bb">hotels & B&B</a>.
  </p>
</ContentPage>

<style>
  .location-list {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .location-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-base);
    padding: var(--space-4);
  }
  .location-card h3 {
    color: var(--color-primary);
    margin: 0 0 var(--space-1);
  }
  .location-type {
    font-weight: 600;
    color: var(--color-accent-1);
    margin: 0 0 var(--space-2);
  }
  .location-contact {
    font-size: var(--font-size-sm);
    opacity: 0.8;
  }
</style>
