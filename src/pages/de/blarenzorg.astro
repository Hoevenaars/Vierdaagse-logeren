---
import ContentPage from '../../layouts/ContentPage.astro';
import AanmeldFormulier from '../../components/AanmeldFormulier.astro';
import aanbieders from '../../data/blarenzorg.json';
---

<ContentPage
  title="Blasenpflege und Massage während des Vierdaagse — Vierdaagse Logeren"
  description="Podologe, Sportmasseur oder Fußpflege während des Vierdaagse gesucht? Übersicht der Anbieter in und um Nijmegen."
  locale="de"
  h1="Blasenpflege und Massage während des Vierdaagse"
>
  <p>
    Blasen, Muskelkater oder einfach eine gute Fußpflege vor der nächsten Tagesetappe —
    während des Vierdaagse gibt es erhöhte Nachfrage nach Podologen, Sportmasseuren und
    Fußpflegern in und um Nijmegen. Hier eine Übersicht.
  </p>

  <h2>Was dich erwartet</h2>
  <p>
    Von Erster Hilfe bei Blasen bis zu einer Sportmassage zur Vorbereitung oder
    Erholung. Manche Anbieter arbeiten nach Termin, andere bieten während der
    Vierdaagse-Woche selbst offene Sprechstunden an.
  </p>

  {aanbieders.length > 0 ? (
    <>
      <h2>Anbieter in dieser Region</h2>
      <div class="location-list">
        {aanbieders.map((a: any) => (
          <div class="location-card">
            <h3>{a.naam} — {a.plaats}</h3>
            <p class="location-type">{a.type}</p>
            <p>{a.beschrijving}</p>
            <p class="location-contact">Kontakt: {a.contact}</p>
          </div>
        ))}
      </div>
    </>
  ) : (
    <p class="callout">
      Wir bauen gerade eine Übersicht der Anbieter auf. Bist du Podologe, Sportmasseur
      oder Fußpfleger? Melde dich unten an.
    </p>
  )}

  <AanmeldFormulier
    categorie="blarenzorg"
    typeOpties={['Podotherapeut', 'Sportmasseur', 'Pedicure', 'Anders']}
    titel="Selbst Blasenpflege oder Massage anbieten?"
    introtekst="Bist du Podologe, Sportmasseur oder Fußpfleger und möchtest während des Vierdaagse sichtbar sein? Melde dich unten an."
  />

  <h2>Weitere praktische Infos</h2>
  <p>
    Schau dir auch unseren <a href="/de/gids/wanneer-boeken">Ratgeber zur Planung und Vorbereitung</a>
    des Vierdaagse an.
  </p>
</ContentPage>

<style>
  .location-list {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .location-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-base);
    padding: var(--space-4);
  }
  .location-card h3 {
    color: var(--color-primary);
    margin: 0 0 var(--space-1);
  }
  .location-type {
    font-weight: 600;
    color: var(--color-accent-1);
    margin: 0 0 var(--space-2);
  }
  .location-contact {
    font-size: var(--font-size-sm);
    opacity: 0.8;
  }
</style>
