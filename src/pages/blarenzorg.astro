---
import ContentPage from '../layouts/ContentPage.astro';
import AanmeldFormulier from '../components/AanmeldFormulier.astro';
import aanbieders from '../data/blarenzorg.json';
---

<ContentPage
  title="Blarenzorg en massage tijdens de Vierdaagse — Vierdaagse Logeren"
  description="Podotherapeut, sportmasseur of pedicure nodig tijdens de Vierdaagse? Overzicht van aanbieders in en rond Nijmegen."
  locale="nl"
  h1="Blarenzorg en massage tijdens de Vierdaagse"
>
  <p>
    Blaren, spierpijn, of gewoon een goede voetverzorging vóór de volgende dagmars —
    tijdens de Vierdaagse is er extra vraag naar podotherapeuten, sportmasseurs en
    pedicures in en rond Nijmegen. Hier vind je een overzicht.
  </p>

  <h2>Wat kun je verwachten</h2>
  <p>
    Van eerste hulp bij blaren tot een sportmassage ter voorbereiding of herstel.
    Sommige aanbieders werken op afspraak, anderen bieden inloopspreekuur tijdens de
    Vierdaagse-week zelf.
  </p>

  {aanbieders.length > 0 ? (
    <>
      <h2>Aanbieders in dit gebied</h2>
      <div class="location-list">
        {aanbieders.map((a: any) => (
          <div class="location-card">
            <h3>{a.naam} — {a.plaats}</h3>
            <p class="location-type">{a.type}</p>
            <p>{a.beschrijving}</p>
            <p class="location-contact">Contact: {a.contact}</p>
          </div>
        ))}
      </div>
    </>
  ) : (
    <p class="callout">
      We bouwen momenteel een overzicht van aanbieders op. Ben je zelf podotherapeut,
      sportmasseur of pedicure? Meld je hieronder aan.
    </p>
  )}

  <AanmeldFormulier
    categorie="blarenzorg"
    typeOpties={['Podotherapeut', 'Sportmasseur', 'Pedicure', 'Anders']}
    titel="Zelf blarenzorg of massage aanbieden?"
    introtekst="Ben je podotherapeut, sportmasseur of pedicure en wil je zichtbaar zijn tijdens de Vierdaagse? Meld je hieronder aan."
  />

  <h2>Overig praktisch</h2>
  <p>
    Bekijk ook onze <a href="/gids/wanneer-boeken">gids over plannen en voorbereiden</a>
    voor de Vierdaagse.
  </p>
</ContentPage>

<style>
  .location-list {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .location-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-base);
    padding: var(--space-4);
  }
  .location-card h3 {
    color: var(--color-primary);
    margin: 0 0 var(--space-1);
  }
  .location-type {
    font-weight: 600;
    color: var(--color-accent-1);
    margin: 0 0 var(--space-2);
  }
  .location-contact {
    font-size: var(--font-size-sm);
    opacity: 0.8;
  }
</style>
