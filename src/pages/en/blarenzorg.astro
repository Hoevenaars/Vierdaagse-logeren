---
import ContentPage from '../../layouts/ContentPage.astro';
import AanmeldFormulier from '../../components/AanmeldFormulier.astro';
import aanbieders from '../../data/blarenzorg.json';
---

<ContentPage
  title="Blister care and massage during the Four Days Marches — Vierdaagse Logeren"
  description="Need a podiatrist, sports masseur, or pedicure during the Four Days Marches? Overview of providers in and around Nijmegen."
  locale="en"
  h1="Blister care and massage during the Four Days Marches"
>
  <p>
    Blisters, sore muscles, or just good foot care before the next day's march — during
    the Four Days Marches there's extra demand for podiatrists, sports masseurs, and
    pedicures in and around Nijmegen. Here's an overview.
  </p>

  <h2>What to expect</h2>
  <p>
    From first aid for blisters to a sports massage for preparation or recovery. Some
    providers work by appointment, others offer walk-in hours during the Four Days
    Marches week itself.
  </p>

  {aanbieders.length > 0 ? (
    <>
      <h2>Providers in this area</h2>
      <div class="location-list">
        {aanbieders.map((a: any) => (
          <div class="location-card">
            <h3>{a.naam} — {a.plaats}</h3>
            <p class="location-type">{a.type}</p>
            <p>{a.beschrijving}</p>
            <p class="location-contact">Contact: {a.contact}</p>
          </div>
        ))}
      </div>
    </>
  ) : (
    <p class="callout">
      We're building an overview of providers. Are you a podiatrist, sports masseur, or
      pedicure? Sign up below.
    </p>
  )}

  <AanmeldFormulier
    categorie="blarenzorg"
    typeOpties={['Podotherapeut', 'Sportmasseur', 'Pedicure', 'Anders']}
    titel="Offer blister care or massage yourself?"
    introtekst="Are you a podiatrist, sports masseur, or pedicure and want to be visible during the Four Days Marches? Sign up below."
  />

  <h2>Other practical info</h2>
  <p>
    Also check our <a href="/en/gids/wanneer-boeken">guide on planning and preparing</a>
    for the Four Days Marches.
  </p>
</ContentPage>

<style>
  .location-list {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .location-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-base);
    padding: var(--space-4);
  }
  .location-card h3 {
    color: var(--color-primary);
    margin: 0 0 var(--space-1);
  }
  .location-type {
    font-weight: 600;
    color: var(--color-accent-1);
    margin: 0 0 var(--space-2);
  }
  .location-contact {
    font-size: var(--font-size-sm);
    opacity: 0.8;
  }
</style>
