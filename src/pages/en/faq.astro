---
import ContentPage from '../../layouts/ContentPage.astro';

const faqs = [
  {
    q: 'When should I book for the Four Days Marches?',
    a: 'As early as possible — as soon as the dates are announced. Campsites and central hotels often fill up months in advance. See the full guide for a concrete timeline.',
  },
  {
    q: 'Is Vierdaagse Logeren the official website of the event?',
    a: 'No. Vierdaagse Logeren is independent from Stichting DE4D and the municipality of Nijmegen. We help visitors find a place to stay, separate from the official organisation.',
  },
  {
    q: 'What does an overnight stay cost during the Four Days Marches?',
    a: "It depends on the type of stay: camping is usually the cheapest, private stays fall in between, and hotels are the most expensive — especially centrally located ones.",
  },
  {
    q: 'Can I stay with a local?',
    a: 'Yes, private stays (a room, garden, or driveway at someone\u2019s home) are a popular and often more affordable alternative. Check our private stays page for more info.',
  },
  {
    q: 'Are there options outside Nijmegen?',
    a: 'Definitely. Towns like Wijchen, Groesbeek, and Cuijk are along the route and often offer more availability than Nijmegen itself.',
  },
  {
    q: 'Do you earn money if I book through you?',
    a: 'For some bookings we receive a small commission through affiliate links. This does not affect our recommendations and costs you nothing extra.',
  },
];
---

<ContentPage
  title="Frequently asked questions — Vierdaagse Logeren"
  description="Frequently asked questions about staying overnight during the Nijmegen Four Days Marches."
  locale="en"
  h1="Frequently asked questions about staying during the Four Days Marches"
>
  <div itemscope itemtype="https://schema.org/FAQPage">
    {faqs.map((item) => (
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="faq-item">
        <h2 itemprop="name">{item.q}</h2>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text">{item.a}</p>
        </div>
      </div>
    ))}
  </div>
</ContentPage>

<style>
  .faq-item {
    margin-bottom: var(--space-5);
  }
</style>
