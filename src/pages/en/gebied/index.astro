---
import ContentPage from '../../../layouts/ContentPage.astro';

const areas = [
  { slug: 'groesbeek', name: 'Groesbeek' },
  { slug: 'wijchen', name: 'Wijchen' },
  { slug: 'cuijk', name: 'Cuijk' },
];
---

<ContentPage
  title="Staying near Nijmegen — Vierdaagse Logeren"
  description="Overview of towns around Nijmegen where you can stay during the Four Days Marches."
  locale="en"
  h1="Staying in the area around Nijmegen"
>
  <p>
    Nijmegen itself is the first to fill up during the Four Days Marches. The
    surrounding municipalities along the route often offer more availability, at a
    comparable travel time.
  </p>
  <ul>
    {areas.map((area) => (
      <li><a href={`/en/gebied/${area.slug}`}>{area.name}</a></li>
    ))}
  </ul>
  <p class="callout">We're expanding this overview with more towns along the route.</p>
</ContentPage>
