---
import ContentPage from './ContentPage.astro';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface GebiedVeld {
  nl: string;
  de: string;
  en: string;
}

interface GebiedData {
  slug: string;
  naam: string;
  titel: GebiedVeld;
  seoBeschrijving: GebiedVeld;
  intro: GebiedVeld;
  afstand: GebiedVeld;
  typeVerblijf: GebiedVeld;
  praktisch: GebiedVeld;
}

interface Props {
  data: GebiedData;
  locale: Locale;
}

const { data, locale } = Astro.props;
const t = useTranslations(locale);

// Val terug op NL zolang een vertaling nog leeg is (concept nog niet gecontroleerd).
function veld(v: GebiedVeld): string {
  return v[locale]?.trim() ? v[locale] : v.nl;
}

// Onderscheid "nog in te vullen" van een echte, afgeronde tip — zodat een halve
// gemeentepagina er niet uitziet als een complete. Zie brandbook-restyle-notitie.
function isPlaceholder(text: string): boolean {
  return /^\[.*\]$/.test(text.trim());
}

const labels = {
  afstand: { nl: 'Afstand tot Nijmegen/de route', de: 'Entfernung nach Nijmegen/zur Route', en: 'Distance to Nijmegen/the route' },
  type: { nl: 'Type verblijf in dit gebied', de: 'Unterkunftsarten in dieser Region', en: 'Type of stay in this area' },
  praktisch: { nl: 'Praktisch', de: 'Praktisches', en: 'Practical info' },
  verder: { nl: 'Verder zoeken', de: 'Weiter suchen', en: 'Keep looking' },
  camping: { nl: 'Campings bekijken', de: 'Campingplätze ansehen', en: 'Browse campsites' },
  hotels: { nl: "Hotels & B&B's bekijken", de: 'Hotels & B&Bs ansehen', en: 'Browse hotels & B&Bs' },
  particulier: { nl: 'Particuliere verhuur bekijken', de: 'Privatunterkünfte ansehen', en: 'Browse private stays' },
  gidsLink: { nl: 'Gids: wanneer moet je boeken?', de: 'Ratgeber: Wann solltest du buchen?', en: 'Guide: when should you book?' },
} as const;

const afstandText = veld(data.afstand);
const typeText = veld(data.typeVerblijf);
const praktischText = veld(data.praktisch);
---

<ContentPage
  title={`${veld(data.titel)} — Vierdaagse Logeren`}
  description={veld(data.seoBeschrijving)}
  locale={locale}
  h1={veld(data.titel)}
>
  <p>{veld(data.intro)}</p>

  <h2>{labels.afstand[locale]}</h2>
  <p class={isPlaceholder(afstandText) ? 'callout callout--open' : 'callout callout--tip'}>
    {afstandText}
  </p>

  <h2>{labels.type[locale]}</h2>
  <p class={isPlaceholder(typeText) ? 'callout callout--open' : 'callout callout--tip'}>
    {typeText}
  </p>

  <h2>{labels.praktisch[locale]}</h2>
  <p class={isPlaceholder(praktischText) ? 'callout callout--open' : 'callout callout--tip'}>
    {praktischText}
  </p>

  <h2>{labels.verder[locale]}</h2>
  <ul>
    <li><a href={`/${locale === 'nl' ? '' : locale + '/'}camping`}>{labels.camping[locale]}</a></li>
    <li><a href={`/${locale === 'nl' ? '' : locale + '/'}hotels-bb`}>{labels.hotels[locale]}</a></li>
    <li><a href={`/${locale === 'nl' ? '' : locale + '/'}particuliere-verhuur`}>{labels.particulier[locale]}</a></li>
    <li><a href={`/${locale === 'nl' ? '' : locale + '/'}gids/wanneer-boeken`}>{labels.gidsLink[locale]}</a></li>
  </ul>
</ContentPage>
