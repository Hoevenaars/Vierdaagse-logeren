---
import ContentPage from './ContentPage.astro';
import type { Locale } from '../i18n/ui';

interface Veld {
  nl: string;
  de: string;
  en: string;
}

interface Props {
  data: {
    titel: Veld;
    seoBeschrijving: Veld;
    h1: Veld;
    vragen: { vraag: Veld; antwoord: Veld }[];
  };
  locale: Locale;
}

const { data, locale } = Astro.props;

function veld(v: Veld): string {
  return v[locale]?.trim() ? v[locale] : v.nl;
}
---

<ContentPage
  title={`${veld(data.titel)} — Vierdaagse Logeren`}
  description={veld(data.seoBeschrijving)}
  locale={locale}
  h1={veld(data.h1)}
>
  <div itemscope itemtype="https://schema.org/FAQPage">
    {data.vragen.map((item) => (
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="faq-item">
        <h2 itemprop="name">{veld(item.vraag)}</h2>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text">{veld(item.antwoord)}</p>
        </div>
      </div>
    ))}
  </div>
</ContentPage>

<style>
  .faq-item {
    margin-bottom: var(--space-5);
  }
</style>
