---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  h1: string;
}
const { title, description, locale, h1 } = Astro.props;
---

<BaseLayout title={title} description={description} locale={locale}>
  <article class="content-page">
    <h1>{h1}</h1>
    <slot />
  </article>
</BaseLayout>

<style>
  .content-page {
    max-width: 42rem;
    margin: 0 auto;
  }
  .content-page :global(h1) {
    color: var(--color-primary);
    font-size: var(--font-size-2xl);
  }
  .content-page :global(h2) {
    color: var(--color-accent-1);
    font-size: var(--font-size-xl);
    margin-top: var(--space-6);
  }
  .content-page :global(p) {
    font-size: var(--font-size-base);
  }
  .content-page :global(ul) {
    padding-left: var(--space-4);
  }
  .content-page :global(a) {
    color: var(--color-primary);
    font-weight: 600;
  }
  .content-page :global(.callout) {
    background: var(--color-secondary);
    padding: var(--space-4);
    border-radius: var(--radius-base);
    margin: var(--space-5) 0;
  }
</style>
