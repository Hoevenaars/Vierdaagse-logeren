---
import type { Locale } from '../i18n/ui';
import MatchFlow from './MatchFlow.astro';
import AlertCapture from './AlertCapture.astro';
import { productCopy } from '../lib/copy';
import { getLocalizedPath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const campingsPath = getLocalizedPath('/campings', locale);
---

<section class="hero">
  <p class="tagline">{productCopy.tagline[locale]}</p>
  <h1>{productCopy.heroTitle[locale]}</h1>
  <p class="intro">{productCopy.heroIntro[locale]}</p>
  <MatchFlow locale={locale} action={campingsPath} />
</section>

<section class="value">
  <h2>{locale === 'de' ? 'Vergleiche den kompletten Aufenthalt, nicht nur den Stellplatz' : locale === 'en' ? 'Compare the full stay, not just the pitch' : 'Vergelijk het complete verblijf, niet alleen de standplaats'}</h2>
  <p>
    {locale === 'de'
      ? 'Campingplätze rechnen anders: Woche, Person, Strom, Parken, Kurtaxe. Wir normalisieren das zu einem Gesamtpreis für dein Szenario.'
      : locale === 'en'
        ? 'Campsites price differently: week, person, electricity, parking, tourist tax. We normalise that into one total for your scenario.'
        : 'Campings rekenen anders: week, persoon, stroom, parkeren, toeristenbelasting. Wij maken daarvan één totaal voor jouw scenario.'}
  </p>
  <ul>
    <li>{locale === 'de' ? 'Gesamtpreis inkl. Pflichtkosten' : locale === 'en' ? 'Total price including mandatory fees' : 'Totale prijs inclusief verplichte kosten'}</li>
    <li>{locale === 'de' ? 'Distanz und Fahrradzeit zur Wedren' : locale === 'en' ? 'Distance and cycling time to the Wedren' : 'Afstand en fietstijd naar de Wedren'}</li>
    <li>{locale === 'de' ? 'Ausstattung und Verfügbarkeit' : locale === 'en' ? 'Facilities and availability' : 'Voorzieningen en beschikbaarheid'}</li>
  </ul>
  <p><a href={campingsPath}>{productCopy.allCampings[locale]} →</a></p>
</section>

<AlertCapture locale={locale} />

<section class="secondary">
  <h2>{locale === 'de' ? 'Andere Unterkünfte' : locale === 'en' ? 'Other stays' : 'Andere verblijven'}</h2>
  <p>
    {locale === 'de'
      ? 'Hotels, B&Bs und Privatunterkünfte bleiben nachschlagen-Seiten. Der Kern dieses Platforms ist die Camping-Entscheidung.'
      : locale === 'en'
        ? 'Hotels, B&Bs and private stays remain reference pages. This platform is built around the campsite decision.'
        : 'Hotels, B&B’s en particuliere verhuur blijven naslag. De kern van dit platform is de campingkeuze.'}
  </p>
  <p class="links">
    <a href={getLocalizedPath('/hotels-bb', locale)}>{locale === 'de' ? 'Hotels & B&B' : locale === 'en' ? 'Hotels & B&B' : 'Hotels & B&B'}</a>
    <a href={getLocalizedPath('/particuliere-verhuur', locale)}>{locale === 'de' ? 'Privatunterkunft' : locale === 'en' ? 'Private stays' : 'Particuliere verhuur'}</a>
    <a href={getLocalizedPath('/gebied', locale)}>{locale === 'de' ? 'Regionen' : locale === 'en' ? 'Areas' : 'Gebieden'}</a>
  </p>
</section>

<style>
  .hero {
    background: var(--color-secondary);
    border-radius: var(--radius-base);
    padding: var(--space-6) var(--space-4);
    margin-bottom: var(--space-6);
  }
  .tagline {
    font-family: var(--font-family-heading);
    color: var(--color-accent-1);
    font-weight: 700;
    margin: 0 0 var(--space-2);
  }
  .hero h1 {
    color: var(--color-primary);
    font-size: var(--font-size-2xl);
    margin: 0 0 var(--space-3);
    max-width: 18ch;
  }
  .intro {
    font-size: var(--font-size-lg);
    max-width: 40rem;
  }
  .value, .secondary {
    margin-bottom: var(--space-6);
  }
  .value h2, .secondary h2 {
    color: var(--color-accent-1);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  a { color: var(--color-primary); font-weight: 700; }
</style>
