---
import type { Locale } from '../i18n/ui';

interface Props {
  categorie: 'particulier' | 'camping' | 'hotel' | 'blarenzorg';
  typeOpties: string[];
  titel: string;
  introtekst: string;
  locale?: Locale;
}

const { categorie, typeOpties, titel, introtekst, locale = 'nl' } = Astro.props;
const formId = `location-form-${categorie}`;
const statusId = `form-status-${categorie}`;

const copy = {
  nl: {
    naam: 'Naam *',
    plaats: 'Plaats *',
    type: 'Type',
    beschrijving: 'Beschrijving',
    contact: 'E-mailadres *',
    honeypot: 'Laat dit veld leeg',
    verstuur: 'Aanmelden',
    versturen: 'Versturen...',
    gelukt: 'Bedankt! Je aanmelding is verstuurd. We controleren die handmatig.',
    serverfout: 'Er ging iets mis. Probeer het later opnieuw.',
    netwerkfout: 'Er ging iets mis. Controleer je internetverbinding en probeer het opnieuw.',
    privacy: 'Ik ga akkoord met de verwerking van mijn gegevens volgens de privacyverklaring.',
    privacyLink: 'privacyverklaring',
  },
  en: {
    naam: 'Name *',
    plaats: 'Town *',
    type: 'Type',
    beschrijving: 'Description',
    contact: 'Email address *',
    honeypot: 'Leave this field empty',
    verstuur: 'Sign up',
    versturen: 'Sending...',
    gelukt: 'Thanks! Your signup was sent. We review it manually.',
    serverfout: 'Something went wrong. Please try again later.',
    netwerkfout: 'Something went wrong. Check your internet connection and try again.',
    privacy: 'I agree to the processing of my data according to the privacy statement.',
    privacyLink: 'privacy statement',
  },
  de: {
    naam: 'Name *',
    plaats: 'Ort *',
    type: 'Typ',
    beschrijving: 'Beschreibung',
    contact: 'E-Mail-Adresse *',
    honeypot: 'Dieses Feld leer lassen',
    verstuur: 'Anmelden',
    versturen: 'Wird gesendet...',
    gelukt: 'Danke! Deine Anmeldung wurde gesendet. Wir prüfen sie manuell.',
    serverfout: 'Etwas ist schiefgelaufen. Bitte versuche es später erneut.',
    netwerkfout: 'Etwas ist schiefgelaufen. Überprüfe deine Internetverbindung und versuche es erneut.',
    privacy: 'Ich stimme der Verarbeitung meiner Daten gemäß der Datenschutzerklärung zu.',
    privacyLink: 'Datenschutzerklärung',
  },
}[locale];
---

<h2>{titel}</h2>
<p>{introtekst}</p>

<form
  id={formId}
  class="location-form"
  data-status-id={statusId}
  data-msg-versturen={copy.versturen}
  data-msg-gelukt={copy.gelukt}
  data-msg-serverfout={copy.serverfout}
  data-msg-netwerkfout={copy.netwerkfout}
>
  <input type="hidden" name="categorie" value={categorie} />

  <div class="form-field">
    <label for={`naam-${categorie}`}>{copy.naam}</label>
    <input type="text" id={`naam-${categorie}`} name="naam" required />
  </div>
  <div class="form-field">
    <label for={`plaats-${categorie}`}>{copy.plaats}</label>
    <input type="text" id={`plaats-${categorie}`} name="plaats" required />
  </div>
  <div class="form-field">
    <label for={`type-${categorie}`}>{copy.type}</label>
    <select id={`type-${categorie}`} name="type">
      {typeOpties.map((optie) => <option value={optie}>{optie}</option>)}
    </select>
  </div>
  <div class="form-field">
    <label for={`beschrijving-${categorie}`}>{copy.beschrijving}</label>
    <textarea id={`beschrijving-${categorie}`} name="beschrijving" rows="4"></textarea>
  </div>
  <div class="form-field">
    <label for={`contact-${categorie}`}>{copy.contact}</label>
    <input type="email" id={`contact-${categorie}`} name="contact" required />
  </div>

  <div class="honeypot" aria-hidden="true">
    <label for={`website_hp-${categorie}`}>{copy.honeypot}</label>
    <input type="text" id={`website_hp-${categorie}`} name="website_hp" tabindex="-1" autocomplete="off" />
  </div>
  <div class="form-field form-field--checkbox">
    <label for={`privacy-${categorie}`}>
      <input type="checkbox" id={`privacy-${categorie}`} name="privacy" value="1" required />
      <span>{copy.privacy} <a href={locale === 'nl' ? '/privacy' : `/${locale}/privacy`}>{copy.privacyLink}</a></span>
    </label>
  </div>


  <button type="submit">{copy.verstuur}</button>
  <p id={statusId} role="status" aria-live="polite"></p>
</form>

<style>
  .form-field--checkbox label {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-2);
    font-weight: 400;
  }
  .form-field--checkbox input {
    margin-top: 0.2rem;
  }

  .location-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 28rem;
    background: var(--color-secondary);
    padding: var(--space-4);
    border-radius: var(--radius-base);
    margin-top: var(--space-3);
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .form-field label {
    font-weight: 600;
    font-size: var(--font-size-sm);
  }
  .form-field input,
  .form-field select,
  .form-field textarea {
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-base);
    font-family: var(--font-family-base);
    font-size: var(--font-size-base);
  }
  .form-field input:focus-visible,
  .form-field select:focus-visible,
  .form-field textarea:focus-visible {
    outline: 3px solid var(--color-accent-2);
    outline-offset: 1px;
  }
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .location-form button {
    background: var(--color-primary);
    color: var(--color-text-light);
    border: none;
    padding: var(--space-3);
    border-radius: var(--radius-base);
    font-weight: 700;
    font-size: var(--font-size-base);
    cursor: pointer;
  }
  .location-form button:hover {
    opacity: 0.9;
  }
  .location-form button:focus-visible {
    outline: 3px solid var(--color-accent-2);
    outline-offset: 2px;
  }
  .location-form p[role='status'] {
    font-size: var(--font-size-sm);
    margin: 0;
  }
</style>

<script>
  document.querySelectorAll('form.location-form').forEach((form) => {
    const htmlForm = form as HTMLFormElement;
    if (htmlForm.dataset.bound === '1') return;
    htmlForm.dataset.bound = '1';

    const statusId = htmlForm.dataset.statusId;
    const status = statusId ? document.getElementById(statusId) : null;

    htmlForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (status) status.textContent = htmlForm.dataset.msgVersturen || 'Sending...';

      const formData = new FormData(htmlForm);
      const payload = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('/api/submit-location', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (!response.ok) {
          if (status) status.textContent = result.error || htmlForm.dataset.msgServerfout || '';
          return;
        }

        if (status) status.textContent = htmlForm.dataset.msgGelukt || '';
        htmlForm.reset();
      } catch {
        if (status) status.textContent = htmlForm.dataset.msgNetwerkfout || '';
      }
    });
  });
</script>
