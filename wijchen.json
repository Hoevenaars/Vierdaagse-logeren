/* Design tokens — Vierdaagse Logeren
   Bron: 13B_BRAND_VIERDAAGSE_LOGEREN.md §5 en §6 */

:root {
  /* Kleuren */
  --color-primary: #0F6E56;      /* teal */
  --color-secondary: #F5EFE1;    /* zand/creme */
  --color-accent-1: #D85A30;     /* koraal */
  --color-accent-2: #EF9F27;     /* oker */
  --color-text-dark: #04342C;    /* diepteal, tekst op lichte achtergrond */
  --color-text-light: #F5EFE1;   /* tekst op donkere achtergrond */
  --color-white: #FFFFFF;
  --color-border: #D9D2C0;

  /* Typography schaal (5-7 stappen, zie 13_UI_UX_DESIGN.md §3)
     Merkfonts vastgelegd tijdens restyle juli 2026 — zie 04_BRANDBOOK_TEMPLATE.md §16.
     Fredoka: koppen — rond, warm, sluit aan bij het handgetekende huisje-logo.
     Inter: broodtekst — neutraal en zeer leesbaar op mobiel (self-hosted via @fontsource). */
  --font-family-heading: 'Fredoka', var(--font-family-base);
  --font-family-base: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-size-sm: 0.875rem;
  --font-size-base: 1rem;
  --font-size-lg: 1.25rem;
  --font-size-xl: 1.75rem;
  --font-size-2xl: 2.25rem;
  --font-size-3xl: 3rem;

  /* Spacing schaal (4/8px-grid, zie 13_UI_UX_DESIGN.md §3) */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 1rem;
  --space-4: 1.5rem;
  --space-5: 2rem;
  --space-6: 3rem;
  --space-7: 4.5rem;

  /* Overig */
  --radius-base: 0.75rem;
  --max-width-content: 72rem;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
