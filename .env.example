# Kopieer dit bestand naar .env en vul de echte waarden in.
# .env zelf wordt NOOIT gecommit (staat in .gitignore).
#
# In Vercel: Settings → Environment Variables → voeg deze twee toe.

# API-key van resend.com (gratis tier: 100 e-mails/dag, ruim voldoende voor dit doel)
RESEND_API_KEY=

# E-mailadres waar nieuwe aanmeldingen naartoe gestuurd worden
OWNER_EMAIL=
