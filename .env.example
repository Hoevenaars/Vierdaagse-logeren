# Environment variables for Vierdaagse Logeren
# Copy to .env locally if needed. On Vercel, set these in Project Settings → Environment Variables.

# Resend (contact + listing signup emails)
RESEND_API_KEY=
OWNER_EMAIL=contact@vierdaagselogeren.nl

# GitHub OAuth for Decap CMS (/admin)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Optional: DeepL for the translate GitHub Action
DEEPL_API_KEY=

# Optional: later koppelen van het Supabase-schema (zie supabase/migrations)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
