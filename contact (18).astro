---
import ContentPage from '../../../layouts/ContentPage.astro';

const gebiedenModules = import.meta.glob('../../../data/gebieden/*.json', { eager: true });
const areas = Object.values(gebiedenModules)
  .map((mod: any) => mod.default)
  .sort((a, b) => a.naam.localeCompare(b.naam));
---

<ContentPage
  title="Übernachten in der Umgebung von Nijmegen — Vierdaagse Logeren"
  description="Übersicht der Orte rund um Nijmegen, an denen du während des Vierdaagse übernachten kannst."
  locale="de"
  h1="Übernachten in der Umgebung von Nijmegen"
>
  <p>
    Nijmegen selbst ist während des Vierdaagse als Erstes ausgebucht. Die umliegenden
    Gemeinden entlang der Route bieten oft mehr Verfügbarkeit bei vergleichbarer Reisezeit.
  </p>
  <ul>
    {areas.map((area: any) => (
      <li><a href={`/de/gebied/${area.slug}`}>{area.naam}</a></li>
    ))}
  </ul>
  <p class="callout callout--open">Wir erweitern diese Übersicht um weitere Gemeinden entlang der Route.</p>
</ContentPage>
