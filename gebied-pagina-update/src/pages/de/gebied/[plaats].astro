---
import ContentPage from '../../../layouts/ContentPage.astro';
import gebiedenData from '../../../data/gebieden.json';

export function getStaticPaths() {
  return gebiedenData.gebieden.map((g: any) => ({
    params: { plaats: g.slug },
    props: { gebied: g },
  }));
}

const { gebied } = Astro.props;
const locale = 'de' as const;
function o(field: Record<string, string>) { return field[locale]?.trim() ? field[locale] : field.nl; }

const titel = `${gebied.naam} — Übernachten während des Vierdaagse`;
const seoBeschrijving = `${gebied.naam} liegt ${gebied.afstandKm} von Nijmegen entfernt. Fahrzeit Auto ${gebied.auto}, Fahrrad ${gebied.fiets}, ÖPNV ${gebied.ov}. ${o(gebied.opmerking)}.`;
---

<ContentPage title={titel} description={seoBeschrijving} locale={locale} h1={`Übernachten in ${gebied.naam}`}>
  <p>
    {gebied.naam} liegt etwa {gebied.afstandKm} von Nijmegen entfernt. Mit dem Auto sind es {gebied.auto},
    mit dem Fahrrad {gebied.fiets}. Mit dem ÖPNV rechnen Sie mit {gebied.ov}
    {gebied.station !== 'Geen station' ? <>, über den Bahnhof {gebied.station}</> : <>, in {gebied.naam} selbst gibt es keinen Bahnhof</>}.
  </p>

  <p class="callout callout--open">{o(gebied.opmerking)}.</p>

  <h2>Praktische Übersicht</h2>
  <table class="gebied-tabel">
    <tbody>
      <tr><th>Entfernung zum Wedren</th><td>{gebied.afstandKm}</td></tr>
      <tr><th>Auto</th><td>{gebied.auto}</td></tr>
      <tr><th>Fahrrad</th><td>{gebied.fiets}</td></tr>
      <tr><th>ÖPNV</th><td>{gebied.ov}</td></tr>
      <tr><th>Bahnhof</th><td>{gebied.station}</td></tr>
    </tbody>
  </table>

  <p>
    Suchen Sie eine konkrete Unterkunft in {gebied.naam} oder Umgebung? Sehen Sie das Angebot bei
    <a href="/de/camping">Camping</a>, <a href="/de/hotels-bb">Hotels &amp; B&amp;Bs</a> oder
    <a href="/de/particuliere-verhuur">Privatunterkünften</a>.
  </p>
</ContentPage>

<style>
  .gebied-tabel { width: 100%; border-collapse: collapse; margin: var(--space-4) 0; }
  .gebied-tabel th, .gebied-tabel td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .gebied-tabel th { color: var(--color-primary); font-weight: 600; width: 40%; }
</style>
